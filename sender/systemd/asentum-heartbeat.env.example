# /etc/asentum-heartbeat.env  (root:asentum-hb, mode 0640)

# The heartbeat wallet. Created by "heartbeat.mjs keygen"; keep it private.
HB_KEYFILE=/var/lib/asentum-heartbeat/heartbeat.json
HB_STATE_DIR=/var/lib/asentum-heartbeat

# Heartbeat registry address. Leave unset to use the one in site/config.js.
#HB_REGISTRY=ase1...

# Where to send the heartbeat. The public gateway works. If your validator
# exposes its REST API locally, sending through it also proves that your own
# node accepts and relays transactions.
HB_RPC=https://testnet.asentum.com
#HB_RPC=http://127.0.0.1:<your-node-rpc-port>

# A heartbeat counts as stuck if it is not in a block after this long.
HB_TIMEOUT_MS=90000

# Optional: get a message when heartbeats start failing and when they recover.
# An ntfy topic URL works as is; any other URL receives JSON {title, message, priority}.
#HB_ALERT_URL=https://ntfy.sh/<your-secret-topic>
