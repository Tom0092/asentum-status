[Unit]
Description=Asentum Status: send one heartbeat
Documentation=https://github.com/Tom0092/asentum-status
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=asentum-hb
Group=asentum-hb
WorkingDirectory=/opt/asentum-status
EnvironmentFile=/etc/asentum-heartbeat.env
ExecStart=/usr/bin/node sender/heartbeat.mjs beat
# The sender gives up on its own after HB_DEADLINE_MS (default HB_TIMEOUT_MS
# + 35 s = 125 s), then records the failure and may POST an alert (10 s at
# most). Keep this limit above that, or systemd kills it first and the alert
# never goes out. Raise both together if you raise HB_TIMEOUT_MS.
TimeoutStartSec=180
# Exit 2 = stuck, 3 = rejected, 4 = RPC unreachable, 5 = failed in a block.
# The unit shows as failed; the next timer run tries again.

# Hardening: the sender only needs the network and its own state directory.
StateDirectory=asentum-heartbeat
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
